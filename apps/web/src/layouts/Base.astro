---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | French Learning</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf8f5;
    --surface: #ffffff;
    --text: #1f1d1a;
    --muted: #6b665f;
    --border: #e6e1d9;
    --accent: #1f4fd1;
    --accent-soft: #e6ecfb;
    --caution: #b4531f;
    --caution-soft: #fbeee6;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161513;
      --surface: #201f1c;
      --text: #f1eee9;
      --muted: #a39d94;
      --border: #34322e;
      --accent: #8aa8ff;
      --accent-soft: #23304f;
      --caution: #f0a070;
      --caution-soft: #3a2a20;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Hiragino Sans', sans-serif;
    line-height: 1.6;
  }
  a {
    color: var(--accent);
  }
</style>
