---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MistakeList from '../../components/MistakeList.astro';
import { audioUrl } from '../../lib/audio';

export async function getStaticPaths() {
  const contrasts = await getCollection('contrasts');
  return contrasts.map((contrast) => ({
    params: { slug: contrast.id },
    props: { contrast },
  }));
}

const { contrast } = Astro.props as { contrast: CollectionEntry<'contrasts'> };
const { title, lead, labels, ladder, pairs: rawPairs } = contrast.data;

// 選択肢（a, b, c…）。2 択のことも 3 択のこともある
const sides = Object.keys(labels);
const names = sides.map((side) => labels[side].name).join(' / ');

const ladderSrc = audioUrl(ladder.fr);
const pairs = rawPairs.map((p) =>
  Object.fromEntries(sides.map((side) => [side, { ...p[side], src: audioUrl(p[side].fr) }])),
);

// クイズの出題候補。ブラウザ側でランダムに選ぶ
const quizItems = pairs.flatMap((p) => sides.map((side) => ({ ...p[side], answer: side })));
---

<Base title={title}>
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </header>

    <section class="card">
      <div class="section-head">
        <h2>1. 口の形：{ladder.title}</h2>
        <button type="button" class="pill play" data-src={ladderSrc}>▶ お手本</button>
      </div>
      <ol class="ladder">
        {
          ladder.steps.map((s) => (
            <li>
              <span class="mark">{s.mark}</span>
              <span class="ipa">[{s.ipa}]</span>
              <span class="mouth">{s.mouth}</span>
            </li>
          ))
        }
      </ol>
      <p class="tip">{ladder.tip}</p>
    </section>

    <section class="card">
      <h2>2. 聞き比べ</h2>
      <p class="sub">{names} だけが違う単語の組。交互に聞いて、違いを感じる。</p>
      <ul class="pairs" style={`--columns: ${sides.length}`}>
        {
          pairs.map((p) => (
            <li class="pair">
              {sides.map((side) => (
                <button type="button" class="word play" data-src={p[side].src}>
                  <span class="tag">{labels[side].name}</span>
                  <span class="fr">{p[side].fr}</span>
                  <span class="ipa">[{p[side].ipa}]</span>
                  <span class="ja">{p[side].ja}</span>
                </button>
              ))}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card" id="quiz" data-items={JSON.stringify(quizItems)} data-labels={JSON.stringify(labels)}>
      <h2>3. 聞き取りクイズ</h2>
      <p class="sub">再生される単語が {names} のどれかを当てる。</p>
      <div class="quiz-controls">
        <button type="button" id="quiz-next" class="pill primary">▶ 出題する</button>
        <button type="button" id="quiz-replay" class="pill" disabled>もう一度聞く</button>
        <span id="quiz-score" class="score">0 / 0</span>
      </div>
      <div class="answers" style={`--columns: ${sides.length}`}>
        {
          sides.map((side) => (
            <button type="button" class="answer" data-answer={side} disabled>
              {labels[side].name}
              <small>{labels[side].hint}</small>
            </button>
          ))
        }
      </div>
      <p id="quiz-result" class="result" aria-live="polite"></p>
      <MistakeList />
    </section>
  </main>
</Base>

<script>
  import { createMistakeList } from '../../scripts/mistakes';

  // 選択肢のキー（a, b, c…）
  type Side = string;
  type QuizItem = { fr: string; ipa: string; ja: string; src: string; answer: Side };
  type Labels = Record<Side, { name: string; hint: string }>;

  // 音声を重ねて鳴らさないよう、Audio は 1 つだけ使い回す
  const audio = new Audio();

  function play(src: string, button?: Element) {
    document.querySelectorAll('.play').forEach((b) => b.classList.toggle('playing', b === button));
    audio.src = src;
    audio.onended = () => button?.classList.remove('playing');
    audio.play().catch(() => {});
  }

  document.querySelectorAll<HTMLButtonElement>('.play').forEach((button) =>
    button.addEventListener('click', () => play(button.dataset.src!, button)),
  );

  // クイズ
  const quiz = document.querySelector<HTMLElement>('#quiz')!;
  const items: QuizItem[] = JSON.parse(quiz.dataset.items!);
  const labels: Labels = JSON.parse(quiz.dataset.labels!);
  const nextButton = document.querySelector<HTMLButtonElement>('#quiz-next')!;
  const replayButton = document.querySelector<HTMLButtonElement>('#quiz-replay')!;
  const answerButtons = [...document.querySelectorAll<HTMLButtonElement>('.answer')];
  const scoreLabel = document.querySelector<HTMLElement>('#quiz-score')!;
  const resultLabel = document.querySelector<HTMLElement>('#quiz-result')!;

  const mistakes = createMistakeList(play);

  let current: QuizItem | null = null;
  let correct = 0;
  let total = 0;

  function ask() {
    // 同じ単語が連続すると答えを推測できてしまうので、直前と違うものを選ぶ
    const candidates = items.filter((i) => i !== current);
    current = candidates[Math.floor(Math.random() * candidates.length)];
    resultLabel.textContent = '';
    resultLabel.className = 'result';
    answerButtons.forEach((b) => (b.disabled = false));
    replayButton.disabled = false;
    nextButton.textContent = '▶ 次の問題';
    play(current.src);
  }

  function answer(choice: string) {
    if (!current) return;
    total++;
    const ok = choice === current.answer;
    if (ok) correct++;
    scoreLabel.textContent = `${correct} / ${total}`;
    resultLabel.className = `result ${ok ? 'ok' : 'ng'}`;
    resultLabel.textContent = `${ok ? '正解！' : '残念…'} ${current.fr} [${current.ipa}]（${current.ja}）は ${
      labels[current.answer].name
    }`;
    answerButtons.forEach((b) => (b.disabled = true));
    if (!ok) {
      mistakes.add({
        key: current.fr,
        word: document.createTextNode(current.fr),
        detail: `[${current.ipa}] ${current.ja}`,
        chosen: labels[choice as Side].name,
        correct: labels[current.answer].name,
        src: current.src,
      });
    }
  }

  nextButton.addEventListener('click', ask);
  replayButton.addEventListener('click', () => current && play(current.src));
  answerButtons.forEach((b) => b.addEventListener('click', () => answer(b.dataset.answer!)));
</script>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
  }
  h1 {
    margin: 8px 0 4px;
  }
  h2 {
    font-size: 1.1rem;
    margin: 0;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sub,
  .tip {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 4px 0 12px;
  }
  button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .pill {
    padding: 6px 16px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: none;
    color: var(--accent);
    font-weight: 600;
  }
  .pill.primary {
    background: var(--accent);
    color: var(--bg);
  }
  .pill:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .pill.playing {
    background: var(--accent-soft);
  }
  /* mark は 1 文字（i、é）のことも単語（école）のこともあるので、列幅は固定せず最長の内容に合わせる。
     li を display: contents にして ol 全体を 1 つのグリッドにし、行をまたいで列を揃える */
  .ladder {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    grid-template-columns: max-content max-content 1fr;
    align-items: baseline;
    gap: 6px 14px;
  }
  .ladder li {
    display: contents;
  }
  .mark {
    font-size: 1.6rem;
    font-weight: 700;
  }
  .ipa {
    font-family: 'Charis SIL', 'Doulos SIL', 'Times New Roman', serif;
  }
  .mouth {
    font-size: 0.92rem;
  }
  .pairs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 10px;
  }
  .word {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 12px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    text-align: left;
  }
  .word:hover,
  .word.playing {
    border-color: var(--accent);
  }
  .word.playing {
    background: var(--accent-soft);
  }
  .tag {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .fr {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .ja {
    font-size: 0.85rem;
  }
  .quiz-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .score {
    margin-left: auto;
    font-weight: 600;
  }
  .answers {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 10px;
  }
  .answer {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .answer small {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--muted);
  }
  .answer:not(:disabled):hover {
    border-color: var(--accent);
  }
  .answer:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .result {
    min-height: 1.6em;
    margin: 12px 0 0;
    font-weight: 600;
  }
  .result.ok {
    color: var(--accent);
  }
  .result.ng {
    color: var(--caution);
  }
</style>
