---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { audioUrl } from '../lib/audio';

const accents = (await getCollection('accents')).map((entry) => ({
  id: entry.id,
  ...entry.data,
  src: audioUrl(entry.data.fr),
  words: entry.data.words.map((w) => ({ ...w, src: audioUrl(w.fr) })),
}));
---

<Base title="アクセント記号">
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>アクセント記号</h1>
      <p class="lead">
        記号は飾りではなく、発音や意味を変えます。単語をクリックすると発音を再生します。「まとめて再生」で、同じ記号の単語を続けて聞き比べられます。
      </p>
    </header>

    <div class="sections">
      {
        accents.map((a) => (
          <section class="accent" data-group={a.id}>
            <div class="head">
              <span class="marks">{a.marks}</span>
              <div class="title">
                <button type="button" class="name play" data-src={a.src}>
                  {a.fr} <span aria-hidden="true">🔊</span>
                </button>
                <p class="role">{a.role}</p>
              </div>
              <button type="button" class="play-group" data-group={a.id}>
                ▶ まとめて再生
              </button>
            </div>
            <ul class="words">
              {a.words.map((w) => (
                <li>
                  <button type="button" class="word play" data-src={w.src}>
                    <span class="fr">{w.fr}</span>
                    <span class="ipa">[{w.ipa}]</span>
                    <span class="ja">{w.ja}</span>
                    {w.note && <span class="note">{w.note}</span>}
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</Base>

<script>
  // 音声を重ねて鳴らさないよう、Audio は 1 つだけ使い回す
  const audio = new Audio();
  let session = 0;

  function highlight(el: Element | null) {
    document.querySelectorAll('.play').forEach((b) => b.classList.toggle('playing', b === el));
  }

  function play(button: HTMLButtonElement): Promise<void> {
    highlight(button);
    audio.src = button.dataset.src!;
    return new Promise((resolve) => {
      audio.onended = () => resolve();
      audio.onerror = () => resolve();
      audio.play().catch(() => resolve());
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.play').forEach((button) =>
    button.addEventListener('click', async () => {
      session++;
      await play(button);
      highlight(null);
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('.play-group').forEach((groupButton) =>
    groupButton.addEventListener('click', async () => {
      // 再生中に別のボタンが押されたら、この連続再生は打ち切る
      const current = ++session;
      const words = document.querySelectorAll<HTMLButtonElement>(
        `section[data-group="${groupButton.dataset.group}"] .word`,
      );
      for (const word of words) {
        if (current !== session) return;
        await play(word);
        await new Promise((r) => setTimeout(r, 800));
      }
      if (current === session) highlight(null);
    }),
  );
</script>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
  }
  h1 {
    margin: 8px 0 4px;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 24px;
  }
  .sections {
    display: grid;
    gap: 16px;
  }
  .accent {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .marks {
    font-size: 2.2rem;
    font-weight: 700;
    min-width: 3.5em;
    letter-spacing: 0.08em;
  }
  .title {
    flex: 1;
    min-width: 200px;
  }
  .role {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .name {
    border: none;
    background: none;
    padding: 0;
    font-size: 1.15rem;
    font-weight: 600;
    border-radius: 6px;
  }
  .name.playing {
    background: var(--accent-soft);
  }
  .play-group {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: none;
    color: var(--accent);
    font-weight: 600;
  }
  .words {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .word {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 10px 12px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    text-align: left;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .word:hover {
    border-color: var(--accent);
  }
  .word.playing {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .fr {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .ipa {
    font-family: 'Charis SIL', 'Doulos SIL', 'Times New Roman', serif;
  }
  .ja {
    font-size: 0.9rem;
  }
  .note {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
