---
// 復習画面。保存したクイズの結果（results/、results-api.mjs）から、まだ克服していない問題だけを出題する。
// 「克服した」= 間違えた後に 2 回続けて正解した。1 回の正解だと、2 択のまぐれ当たりと区別できないため。
// 結果は開発サーバーの API から読むので、出題する問題はここで全部用意しておき、ブラウザ側で絞り込む。
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { audioUrl } from '../lib/audio';
import { contrastKey, rulesKey, spellingKey } from '../scripts/results';
import '../styles/material.css';
import '../styles/quiz-keys.css';

const contrasts = await getCollection('contrasts');
const rules = await getCollection('rules');
const spellings = await getCollection('spellings');

const items = [
  ...contrasts.flatMap((c) => {
    const choices = Object.entries(c.data.labels).map(([id, l]) => ({ id, ...l }));
    return c.data.pairs.flatMap((p) =>
      Object.entries(p).map(([side, w]) => ({
        type: 'contrast',
        key: contrastKey(c.id, w.fr),
        title: c.data.title,
        href: `/contrast/${c.id}`,
        fr: w.fr,
        ipa: w.ipa,
        ja: w.ja,
        src: audioUrl(w.fr),
        answer: side,
        choices,
      })),
    );
  }),
  ...rules.flatMap((r) =>
    r.data.quiz.map((q) => {
      const m = q.show.match(/^(.*)\{(.+?)\}(.*)$/)!;
      return {
        type: 'rules',
        key: rulesKey(r.id, q.show),
        title: r.data.title,
        href: `/rules/${r.id}`,
        fr: q.fr,
        ipa: q.ipa,
        ja: q.ja,
        src: audioUrl(q.fr),
        answer: q.answer,
        why: q.why,
        choices: r.data.choices,
        before: m[1],
        target: m[2],
        after: m[3],
      };
    }),
  ),
  ...spellings.flatMap((sp) =>
    sp.data.items.map((i) => ({
      type: 'spelling',
      key: spellingKey(sp.id, i.fr),
      title: sp.data.title,
      href: `/spelling/${sp.id}`,
      fr: i.fr,
      ipa: i.ipa,
      ja: i.ja,
      src: audioUrl(i.fr),
      answer: i.fr,
      // 綴りそのものが選択肢。順番は出題のたびにブラウザ側で混ぜる
      choices: [i.fr, ...i.wrong].map((w) => ({ id: w, name: w, hint: '' })),
    })),
  ),
];
---

<Base title="復習">
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>復習</h1>
      <p class="lead">
        これまでのクイズで間違えて、まだ克服していない問題です。間違えた後に 2 回続けて正解すると、ここから消えます。
      </p>
    </header>

    <p id="status" class="sub">読み込み中…</p>

    <section class="card" id="quiz" data-items={JSON.stringify(items)} hidden>
      <div class="quiz-controls">
        <button type="button" id="quiz-next" class="pill primary">▶ 出題する</button>
        <button type="button" id="quiz-replay" class="pill" hidden>もう一度聞く</button>
        <span id="quiz-score" class="score"></span>
      </div>
      <p id="quiz-title" class="sub">&nbsp;</p>
      <p id="quiz-word" class="quiz-word" aria-live="polite">&nbsp;</p>
      <div id="answers" class="answers"></div>
      <p id="quiz-result" class="result" aria-live="polite"></p>
    </section>

    <section class="card" id="questions" hidden>
      <h2>聞き取り・読む文書・ディクテーションで間違えた問題</h2>
      <p class="sub">文章を読み直したり書き取ったりする問題なので、画面へのリンクだけ出します。</p>
      <ul></ul>
    </section>
  </main>
</Base>

<script>
  import { bindQuizKeys } from '../scripts/quiz-keys';
  import { judge, verdictLabel } from '../scripts/judge';
  import { loadResults, saveResult, type ReviewItem, type SavedResult } from '../scripts/results';

  type Choice = { id: string; name: string; hint: string };
  type Item = {
    type: 'contrast' | 'rules' | 'spelling' | 'vocab' | 'verb' | 'number';
    key: string;
    title: string;
    href: string;
    fr: string;
    ipa: string;
    ja: string;
    src: string;
    answer: string;
    choices: Choice[];
    prompt?: string;
    why?: string;
    before?: string;
    target?: string;
    after?: string;
  };

  const quiz = document.querySelector<HTMLElement>('#quiz')!;
  const items: Item[] = JSON.parse(quiz.dataset.items!);
  const status = document.querySelector<HTMLElement>('#status')!;
  const nextButton = document.querySelector<HTMLButtonElement>('#quiz-next')!;
  const replayButton = document.querySelector<HTMLButtonElement>('#quiz-replay')!;
  const scoreLabel = document.querySelector<HTMLElement>('#quiz-score')!;
  const titleLabel = document.querySelector<HTMLElement>('#quiz-title')!;
  const wordLabel = document.querySelector<HTMLElement>('#quiz-word')!;
  const answers = document.querySelector<HTMLElement>('#answers')!;
  const resultLabel = document.querySelector<HTMLElement>('#quiz-result')!;

  // 音声を重ねて鳴らさないよう、Audio は 1 つだけ使い回す
  const audio = new Audio();
  function play(src: string) {
    audio.src = src;
    audio.play().catch(() => {});
  }

  // key ごとの正誤の履歴（古い順）
  const history = new Map<string, boolean[]>();
  function push(key: string, ok: boolean) {
    history.set(key, [...(history.get(key) ?? []), ok]);
  }

  function isWeak(key: string) {
    const h = history.get(key) ?? [];
    return h.includes(false) && !(h.length >= 2 && h.at(-1) && h.at(-2));
  }

  // 1 周のあいだは同じ問題を出さない。1 周終わったら、残った問題でもう 1 周する
  let round: Item[] = [];
  let current: Item | null = null;
  let correct = 0;
  let total = 0;

  function startRound() {
    round = items.filter((i) => isWeak(i.key)).sort(() => Math.random() - 0.5);
  }

  function updateScore() {
    const left = items.filter((i) => isWeak(i.key)).length;
    scoreLabel.textContent = `${correct} / ${total}（残り ${left} 問）`;
  }

  function ask() {
    if (round.length === 0) startRound();
    current = round.shift() ?? null;
    resultLabel.textContent = '';
    resultLabel.className = 'result';
    if (!current) {
      titleLabel.textContent = '';
      wordLabel.textContent = '全部克服しました 🎉';
      answers.replaceChildren();
      replayButton.hidden = true;
      nextButton.disabled = true;
      return;
    }
    nextButton.textContent = '▶ 次の問題';
    // どの練習の問題かを出す（選択肢の意味がわかるように）。答えのヒントにはならない
    titleLabel.textContent = current.title;
    // 綴り選びと単語は選択肢が答えそのものなので、位置で答えがわからないよう毎回混ぜる
    const shuffled = current.type === 'spelling' || current.type === 'vocab';
    const choices = shuffled ? [...current.choices].sort(() => Math.random() - 0.5) : current.choices;
    // 単語の選択肢（意味・フランス語）は長いので 2 列にする
    answers.style.gridTemplateColumns = `repeat(${current.type === 'vocab' ? 2 : current.type === 'verb' || current.type === 'number' ? 1 : current.choices.length}, 1fr)`;
    if (current.type === 'verb' || current.type === 'number') {
      // 動詞の活用は選択肢がなく、書いて答える（選べても書けないことが多かったため）。数字も聞いて数字で書く
      answers.replaceChildren(typedForm(current.type === 'verb'));
    } else {
      answers.replaceChildren(
        ...choices.map((c) => {
          const b = Object.assign(document.createElement('button'), { type: 'button', className: 'answer' });
          b.append(c.name, Object.assign(document.createElement('small'), { textContent: c.hint }));
          b.addEventListener('click', () => answer(c));
          return b;
        }),
      );
    }
    if (current.prompt) {
      // 単語の「見て意味を選ぶ」「意味からフランス語を選ぶ」は、文字だけで出題する
      wordLabel.textContent = current.prompt;
      replayButton.hidden = true;
    } else if (current.type !== 'rules') {
      // 聞き比べ・綴り選び・単語の「聞いて意味を選ぶ」は音だけで答える
      wordLabel.textContent = '🔊';
      replayButton.hidden = false;
      play(current.src);
    } else {
      const span = document.createElement('span');
      span.append(current.before!, Object.assign(document.createElement('mark'), { textContent: current.target }), current.after!);
      wordLabel.replaceChildren(span);
      replayButton.hidden = true;
    }
  }

  // 書いて答える問題の入力欄。アクセント記号はキーボードで入れにくいので、押すだけで入力できるボタンも付ける
  // withKeys：アクセント記号のボタンを出すか（数字では使わないので出さない）
  function typedForm(withKeys: boolean) {
    const form = Object.assign(document.createElement('div'), { className: 'typed' });
    const input = Object.assign(document.createElement('input'), { type: 'text', autocomplete: 'off', spellcheck: false, lang: 'fr' });
    input.setAttribute('autocapitalize', 'off');
    const keys = Object.assign(document.createElement('div'), { className: 'keys' });
    for (const k of ['é', 'è', 'ê', 'à', 'ç', "'"]) {
      const b = Object.assign(document.createElement('button'), { type: 'button', className: 'key', textContent: k });
      b.addEventListener('mousedown', (e) => e.preventDefault());
      b.addEventListener('click', () => {
        if (input.disabled) return;
        input.setRangeText(k, input.selectionStart ?? input.value.length, input.selectionEnd ?? input.value.length, 'end');
        input.focus();
      });
      keys.append(b);
    }
    const checkButton = Object.assign(document.createElement('button'), { type: 'button', className: 'pill', textContent: '答え合わせ' });
    function check() {
      if (!current || input.disabled || input.value.trim() === '') return;
      const chosen = input.value.trim();
      const verdict = judge(chosen, current.answer);
      input.disabled = true;
      checkButton.disabled = true;
      // 選択肢の問題と同じ流れで記録・表示する（正解なら id を正解にそろえる）
      answer({ id: verdict === 'ok' ? current.answer : chosen, name: chosen, hint: '' });
      if (verdict === 'near') resultLabel.textContent = `${verdictLabel.near}　${resultLabel.textContent}`;
      // Enter で次の問題へ進めるよう、出題ボタンにフォーカスを移す
      nextButton.focus();
    }
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.isComposing) return;
      // 既定の動作を止める。止めないと、check() でフォーカスを移した出題ボタンが同じ Enter で押され、答えを見る前に次の問題へ進んでしまう（2026-10-14）
      e.preventDefault();
      check();
    });
    checkButton.addEventListener('click', check);
    const row = Object.assign(document.createElement('div'), { className: 'typed-row' });
    row.append(input, checkButton);
    form.append(...(withKeys ? [keys] : []), row);
    // 画面に追加された後でフォーカスする
    setTimeout(() => input.focus());
    return form;
  }

  function toReviewItem(item: Item): ReviewItem {
    const { title, href, fr, ipa, ja, src, prompt, answer, choices } = item;
    return { title, href, fr, ipa, ja, src, prompt, answer, choices };
  }

  function answer(choice: Choice) {
    if (!current) return;
    const item = current;
    const ok = choice.id === item.answer;
    // 書いて答える問題（動詞の活用）は選択肢がないので、正解の綴りをそのまま使う
    const correctName = item.choices.find((c) => c.id === item.answer)?.name ?? item.answer;
    total++;
    if (ok) correct++;
    push(item.key, ok);
    saveResult({
      type: item.type,
      key: item.key,
      word: item.type === 'rules' ? `${item.before}{${item.target}}${item.after}` : item.fr,
      chosen: choice.name,
      answer: correctName,
      ok,
      // 単語・動詞の活用・数字は復習画面に問題が埋め込まれていないので、次の復習でも出せるよう中身も保存する
      ...((item.type === 'vocab' || item.type === 'verb' || item.type === 'number') && { item: toReviewItem(item) }),
    });
    answers.querySelectorAll('button').forEach((b) => (b.disabled = true));
    resultLabel.className = `result ${ok ? 'ok' : 'ng'}`;
    resultLabel.textContent = `${ok ? '正解！' : '残念…'} 答えは「${correctName}」：${item.fr} [${item.ipa}]（${item.ja}）${item.why ? `\n理由：${item.why}` : ''}`;
    if (item.type !== 'rules') wordLabel.textContent = item.fr;
    play(item.src);
    // 間違えたら、この周の最後にもう一度出す（その場で覚え直せるように）
    if (!ok) round.push(item);
    updateScore();
  }

  function showQuestions(results: SavedResult[]) {
    // 問題ごとの最後の結果が不正解のものだけ出す
    const last = new Map<string, SavedResult>();
    for (const r of results) if (r.type === 'question' || r.type === 'dictation') last.set(r.key, r);
    const wrong = [...last.values()].filter((r) => !r.ok);
    if (wrong.length === 0) return;
    const section = document.querySelector<HTMLElement>('#questions')!;
    section.querySelector('ul')!.replaceChildren(
      ...wrong.map((r) => {
        const li = document.createElement('li');
        li.append(Object.assign(document.createElement('a'), { href: r.page, textContent: r.page }), `　${r.word}（正解：${r.answer}）`);
        return li;
      }),
    );
    section.hidden = false;
  }

  const results = await loadResults();
  if (!results) {
    status.textContent = '結果を読み込めませんでした。結果の保存と復習は、開発サーバー（npm run dev）でだけ動きます。';
  } else {
    for (const r of results) push(r.key, r.ok);
    // 単語・動詞の活用・数字の問題は、結果に保存した中身（最後に答えたときのもの）から作る
    const vocab = new Map<string, Item>();
    for (const r of results) if ((r.type === 'vocab' || r.type === 'verb' || r.type === 'number') && r.item) vocab.set(r.key, { type: r.type, key: r.key, ...r.item });
    items.push(...vocab.values());
    showQuestions(results);
    const left = items.filter((i) => isWeak(i.key)).length;
    if (left === 0) {
      status.textContent = '復習が必要な問題はありません。各画面のクイズで間違えると、ここに出てきます。';
    } else {
      status.textContent = `復習が必要な問題が ${left} 問あります。`;
      quiz.hidden = false;
      updateScore();
    }
  }

  nextButton.addEventListener('click', ask);
  // 答えた後は Tab でも次の問題へ進める（ユーザーの希望。2026-10-14）。フォーカスは答え合わせのときに出題ボタンへ移している
  nextButton.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || e.shiftKey) return;
    e.preventDefault();
    nextButton.click();
  });
  replayButton.addEventListener('click', () => current && play(current.src));
  bindQuizKeys();
</script>

<style>
  .lead {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .quiz-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .score {
    margin-left: auto;
    font-weight: 600;
  }
  .quiz-word {
    text-align: center;
    font-size: 2.6rem;
    font-weight: 700;
    margin: 4px 0 16px;
    letter-spacing: 0.04em;
  }
  .quiz-word :global(mark) {
    background: var(--caution-soft);
    color: var(--caution);
    border-radius: 6px;
    padding: 0 2px;
  }
  .answers {
    display: grid;
    gap: 10px;
  }
  .answers :global(.answer) {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .answers :global(.answer small) {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }
  .answers :global(.answer:not(:disabled):hover) {
    border-color: var(--accent);
  }
  .answers :global(.answer:disabled) {
    opacity: 0.5;
    cursor: default;
  }
  .result {
    min-height: 1.6em;
    margin: 12px 0 0;
    font-weight: 600;
    /* 理由は改行して別の行に出す */
    white-space: pre-line;
  }
  .answers :global(.typed-row) {
    display: flex;
    gap: 8px;
  }
  .answers :global(.typed input) {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 2px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    font: inherit;
    font-size: 1.2rem;
    color: inherit;
  }
  .answers :global(.typed input:focus) {
    outline: none;
    border-color: var(--accent);
  }
  .answers :global(.keys) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .answers :global(.key) {
    min-width: 2.4em;
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font: inherit;
    font-size: 1.1rem;
    color: inherit;
  }
  #questions ul {
    padding-left: 1.2em;
    margin: 0;
  }
</style>
