---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { audioUrl } from '../../lib/audio';
import '../../styles/material.css';

export async function getStaticPaths() {
  const entries = await getCollection('reading');
  return entries.map((entry) => ({ params: { unit: entry.data.unit }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'reading'> };
const { unit, title, sentences } = entry.data;
---

<Base title={`${unit} リーディング`}>
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>{unit} {title}：1 文リーディング</h1>
      <p class="lead">
        まず自分で読んで意味を考える → ▶ で発音を確かめる → 「意味と単語」で答え合わせ。
        「文を隠す」にすると、音声だけを聞いて書き取る練習（ディクテーション）になります。
      </p>
      <p class="lead">キーボード：j / k か ↓ / ↑ で文を移動、スペースで再生、Enter で「意味と単語」を開く・閉じる。</p>
    </header>

    <div class="toolbar">
      <button type="button" class="pill" id="hide-fr" aria-pressed="false">文を隠す（書き取り）</button>
    </div>

    <ol class="sentences">
      {
        sentences.map((s, i) => (
          <li class="card sentence">
            <div class="row">
              <span class="num">{i + 1}</span>
              <p class="fr text">{s.fr}</p>
              <button type="button" class="pill play" data-src={audioUrl(s.fr)} aria-label="再生">
                ▶
              </button>
            </div>
            <details>
              <summary>意味と単語</summary>
              <p class="ja">{s.ja}</p>
              {s.grammar && <p class="grammar">文法：{s.grammar}</p>}
              {s.words.length > 0 && (
                <dl class="gloss">
                  {s.words.map((w) => (
                    <>
                      <dt>{w.w}</dt>
                      <dd>{w.ja}</dd>
                    </>
                  ))}
                </dl>
              )}
            </details>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<script>
  import { bindPlayButtons } from '../../scripts/player';

  bindPlayButtons();

  const button = document.querySelector<HTMLButtonElement>('#hide-fr')!;
  const main = document.querySelector('main')!;
  button.addEventListener('click', () => {
    const on = button.getAttribute('aria-pressed') !== 'true';
    button.setAttribute('aria-pressed', String(on));
    main.classList.toggle('hide-fr', on);
  });
  // 書き取りの答え合わせ：隠しているときは、文をクリックするとその文だけ表示する
  document.querySelectorAll('.text').forEach((el) => el.addEventListener('click', () => el.classList.add('revealed')));

  // キーボードだけで読み進められるようにする（ユーザーの希望。2026-10-15）。
  // マウスとキーボードを行き来すると、読むことへの集中が途切れるため
  const sentences = [...document.querySelectorAll<HTMLElement>('.sentence')];
  let current = 0;
  function select(i: number) {
    current = Math.max(0, Math.min(sentences.length - 1, i));
    sentences.forEach((s, j) => s.classList.toggle('current', j === current));
    sentences[current].scrollIntoView({ block: 'nearest' });
  }
  // クリックした文も選ぶ。マウスで再生した後にキーボードで続けられるように
  sentences.forEach((s, i) => s.addEventListener('click', () => select(i)));
  select(0);

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.target instanceof HTMLSelectElement || e.target instanceof HTMLInputElement) return;
    const sentence = sentences[current];
    if (e.key === 'j' || e.key === 'ArrowDown') select(current + 1);
    else if (e.key === 'k' || e.key === 'ArrowUp') select(current - 1);
    else if (e.key === ' ') sentence.querySelector<HTMLButtonElement>('.play')!.click();
    else if (e.key === 'Enter') {
      const details = sentence.querySelector('details')!;
      details.open = !details.open;
    } else return;
    // 既定の動作（ページのスクロール、フォーカス中のボタンや summary の操作）と二重に動かないよう止める
    e.preventDefault();
  });
</script>

<style>
  .sentences {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sentence {
    margin-bottom: 10px;
    padding: 12px 16px;
  }
  .sentence.current {
    outline: 2px solid var(--accent);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .num {
    color: var(--muted);
    font-size: 0.85rem;
    min-width: 1.5em;
  }
  .text {
    flex: 1;
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  main.hide-fr .text:not(.revealed) {
    color: transparent;
    background: var(--border);
    border-radius: 6px;
    cursor: pointer;
    user-select: none;
  }
  details {
    margin: 6px 0 0 calc(1.5em + 12px);
  }
  .ja {
    margin: 6px 0 2px;
  }
  .grammar {
    margin: 0 0 6px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .gloss {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 2px 12px;
    margin: 0;
    font-size: 0.9rem;
  }
  .gloss dt {
    font-weight: 600;
  }
  .gloss dd {
    margin: 0;
  }
</style>
