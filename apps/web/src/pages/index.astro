---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { documentId, listeningId } from '../lib/materials';

// 単元 01 以降は教材の YAML から一覧を作る（教材を足すとリンクも自動で増える）
const vocab = await getCollection('vocab');
const reading = await getCollection('reading');
const listening = await getCollection('listening');
const documents = await getCollection('documents');

const units = [...new Set([...vocab, ...reading, ...listening, ...documents].map((e) => e.data.unit))].sort();
// 単元 11（DELF 対策）は単語やリーディングがなく、模試のタイトルは単元名にならないため、名前をここに書く
const extraTitles: Record<string, string> = { '11': 'DELF 対策（模試）' };
const unitTitle = (unit: string) =>
  [...vocab, ...reading].find((e) => e.data.unit === unit)?.data.title ?? extraTitles[unit] ?? '';
// レベル（A1 / A2）は教材の置き場所（materials/<レベル>/）から取る。単元の番号はレベルをまたいで通し番号
const unitLevel = (unit: string) =>
  [...vocab, ...reading, ...listening, ...documents]
    .find((e) => e.data.unit === unit)!
    .id.split('/')[0]
    .toUpperCase();
---

<Base title="ホーム">
  <main>
    <h1>French Learning</h1>
    <p>ゼロから AI だけでフランス語を学ぶ実験の学習アプリ。</p>
    <p><a href="/review">復習（これまでに間違えた問題）</a></p>
    <h2>A1 / 単元 00：発音と綴り</h2>
    <ul>
      <li><a href="/alphabet">00-1 アルファベット</a></li>
      <li><a href="/accents">00-1 アクセント記号</a></li>
      <li><a href="/contrast/e">00-1 é と è の聞き比べ</a></li>
      <li><a href="/contrast/u">00-2 u と ou の聞き比べ</a></li>
      <li><a href="/contrast/o">00-2 o と ɔ の聞き比べ</a></li>
      <li><a href="/rules/e">00-2 アクセント記号のない e の読み方</a></li>
      <li><a href="/rules/vowels">00-3 複数の文字で 1 つの音を表す綴り</a></li>
      <li><a href="/contrast/nasal">00-4 鼻母音 [ɛ̃] [ɑ̃] [ɔ̃] の聞き比べ</a></li>
      <li><a href="/rules/nasal">00-4 鼻母音になるかどうか</a></li>
      <li><a href="/rules/final">00-5 語末の子音を読むかどうか</a></li>
      <li><a href="/rules/cg">00-5 c と g の読み方</a></li>
      <li><a href="/contrast/s">00-5 s の [s] と [z] の聞き比べ</a></li>
      <li><a href="/rules/letters">00-5 2 文字以上で 1 つの音を表す子音の綴り</a></li>
      <li><a href="/contrast/r">00-5 r と l の聞き比べ</a></li>
      <li><a href="/rules/liaison">00-6 リエゾンするかどうか</a></li>
      <li><a href="/contrast/sz">00-6 ils sont と ils ont の聞き比べ</a></li>
    </ul>

    <h2>A1 / 単元をまたぐ教材</h2>
    <ul>
      <li><a href="/numbers">数字・日付・時刻・値段</a></li>
      <li><a href="/verbs">動詞の活用</a></li>
    </ul>

    {
      units.map((unit) => (
        <section>
          <h2>
            {unitLevel(unit)} / 単元 {unit}：{unitTitle(unit)}
          </h2>
          <ul>
            {vocab.some((e) => e.data.unit === unit) && (
              <li>
                <a href={`/vocab/${unit}`}>単語</a>
              </li>
            )}
            {reading.some((e) => e.data.unit === unit) && (
              <li>
                <a href={`/reading/${unit}`}>1 文リーディング</a>
              </li>
            )}
            {listening
              .filter((e) => e.data.unit === unit)
              .sort((a, b) => listeningId(a).localeCompare(listeningId(b)))
              .map((e) => (
                <li>
                  <a href={`/listening/${listeningId(e)}`}>聞き取り：{e.data.title}</a>
                </li>
              ))}
            {documents
              .filter((e) => e.data.unit === unit)
              .sort((a, b) => documentId(a).localeCompare(documentId(b)))
              .map((e) => (
                <li>
                  <a href={`/document/${documentId(e)}`}>読む（DELF 形式）：{e.data.title}</a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }

    <h2>設定</h2>
    <ul>
      <li><a href="/voices">声の聞き比べ</a></li>
    </ul>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 16px;
  }
</style>
