---
// 単語のクイズ。単語の画面（/vocab/<単元>）で聞いて覚えた後に、覚えたかを確かめる。
// 形式は 3 つ：聞いて意味を選ぶ（聞く力）・見て意味を選ぶ（読む力）・意味からフランス語を選ぶ（思い出す力）
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import MistakeList from '../../../components/MistakeList.astro';
import { audioUrl } from '../../../lib/audio';
import '../../../styles/material.css';

export async function getStaticPaths() {
  const entries = await getCollection('vocab');
  return entries.map((entry) => ({ params: { unit: entry.data.unit }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'vocab'> };
const { unit, title, groups } = entry.data;
const words = groups.flatMap((g, gi) =>
  g.words.map((w) => ({ fr: w.fr, ipa: w.ipa, ja: w.ja, src: audioUrl(w.tts ?? w.fr), group: gi })),
);
---

<Base title={`${unit} 単語クイズ`}>
  <main>
    <header>
      <a href={`/vocab/${unit}`} class="back">← 単語の画面</a>
      <h1>{unit} {title}：単語クイズ</h1>
      <p class="lead">形式と範囲を選んで、20 問ずつ解きます。間違えた問題は復習画面（/review）にも出ます。</p>
    </header>

    <section class="card" id="quiz" data-unit={unit} data-title={title} data-words={JSON.stringify(words)}>
      <div class="settings">
        <label>
          形式
          <select id="mode">
            <option value="listen">聞いて意味を選ぶ</option>
            <option value="read">見て意味を選ぶ</option>
            <option value="recall">意味からフランス語を選ぶ</option>
          </select>
        </label>
        <label>
          範囲
          <select id="group">
            <option value="all">全部</option>
            {groups.map((g, i) => <option value={i}>{g.name}</option>)}
          </select>
        </label>
      </div>
      <div class="quiz-controls">
        <button type="button" id="quiz-next" class="pill primary">▶ 出題する</button>
        <button type="button" id="quiz-replay" class="pill" hidden>もう一度聞く</button>
        <span id="quiz-score" class="score">0 / 0（全 20 問）</span>
      </div>
      <p id="quiz-word" class="quiz-word" aria-live="polite">&nbsp;</p>
      <div id="answers" class="answers"></div>
      <p id="quiz-result" class="result" aria-live="polite"></p>
      <MistakeList />
    </section>
  </main>
</Base>

<script>
  import { createMistakeList } from '../../../scripts/mistakes';
  import { play } from '../../../scripts/player';
  import { saveResult, vocabKey, type ReviewItem } from '../../../scripts/results';
  import { ROUND_SIZE, createDeck } from '../../../scripts/round';

  type Word = { fr: string; ipa: string; ja: string; src: string; group: number };
  type Mode = 'listen' | 'read' | 'recall';

  const modeNames: Record<Mode, string> = {
    listen: '聞いて意味を選ぶ',
    read: '見て意味を選ぶ',
    recall: '意味からフランス語を選ぶ',
  };

  const quiz = document.querySelector<HTMLElement>('#quiz')!;
  const unit = quiz.dataset.unit!;
  const unitTitle = quiz.dataset.title!;
  const words: Word[] = JSON.parse(quiz.dataset.words!);
  const modeSelect = document.querySelector<HTMLSelectElement>('#mode')!;
  const groupSelect = document.querySelector<HTMLSelectElement>('#group')!;
  const nextButton = document.querySelector<HTMLButtonElement>('#quiz-next')!;
  const replayButton = document.querySelector<HTMLButtonElement>('#quiz-replay')!;
  const scoreLabel = document.querySelector<HTMLElement>('#quiz-score')!;
  const wordLabel = document.querySelector<HTMLElement>('#quiz-word')!;
  const answers = document.querySelector<HTMLElement>('#answers')!;
  const resultLabel = document.querySelector<HTMLElement>('#quiz-result')!;

  const mistakes = createMistakeList((src, button) => play(src, button));

  let current: { word: Word; item: ReviewItem; key: string } | null = null;
  let correct = 0;
  let total = 0;
  let nextWord = createDeck(words);

  const shuffle = <T,>(a: T[]) => [...a].sort(() => Math.random() - 0.5);

  // 形式・範囲を変えたら、点数と出題の順番をやり直す
  function reset() {
    const g = groupSelect.value;
    nextWord = createDeck(g === 'all' ? words : words.filter((w) => w.group === Number(g)));
    correct = 0;
    total = 0;
    current = null;
    scoreLabel.textContent = `0 / 0（全 ${ROUND_SIZE} 問）`;
    wordLabel.innerHTML = '&nbsp;';
    answers.replaceChildren();
    resultLabel.textContent = '';
    replayButton.hidden = true;
    nextButton.textContent = '▶ 出題する';
  }

  // 誤りの選択肢は同じグループから選ぶ（似た種類の語と見分ける練習になるため）。
  // グループが小さいときは単元全体から足す。意味が同じ語（表記違い）は選択肢にしない
  function distractors(word: Word, mode: Mode) {
    const label = (w: Word) => (mode === 'recall' ? w.fr : w.ja);
    const others = (pool: Word[]) => shuffle(pool.filter((w) => label(w) !== label(word) && w.ja !== word.ja));
    const picked = others(words.filter((w) => w.group === word.group)).slice(0, 3);
    for (const w of others(words)) {
      if (picked.length >= 3) break;
      if (!picked.some((p) => label(p) === label(w))) picked.push(w);
    }
    return picked.map(label);
  }

  function makeItem(word: Word, mode: Mode): ReviewItem {
    const answer = mode === 'recall' ? word.fr : word.ja;
    const choices = shuffle([answer, ...distractors(word, mode)]).map((c) => ({ id: c, name: c, hint: '' }));
    return {
      title: `${unit} ${unitTitle}の単語（${modeNames[mode]}）`,
      href: `/vocab/${unit}/quiz`,
      fr: word.fr,
      ipa: word.ipa,
      ja: word.ja,
      src: word.src,
      prompt: mode === 'listen' ? undefined : mode === 'read' ? word.fr : word.ja,
      answer,
      choices,
    };
  }

  function ask() {
    if (total >= ROUND_SIZE) {
      correct = 0;
      total = 0;
      scoreLabel.textContent = `0 / 0（全 ${ROUND_SIZE} 問）`;
    }
    const mode = modeSelect.value as Mode;
    const word = nextWord();
    const item = makeItem(word, mode);
    current = { word, item, key: vocabKey(unit, mode, word.fr) };
    resultLabel.textContent = '';
    resultLabel.className = 'result';
    nextButton.textContent = '▶ 次の問題';
    answers.replaceChildren(
      ...item.choices.map((c) => {
        const b = Object.assign(document.createElement('button'), { type: 'button', className: 'answer', textContent: c.name });
        b.addEventListener('click', () => answer(c.id));
        return b;
      }),
    );
    if (item.prompt) {
      wordLabel.textContent = item.prompt;
      replayButton.hidden = true;
    } else {
      // 聞いて答える形式は、文字を見せずに音だけで出題する
      wordLabel.textContent = '🔊';
      replayButton.hidden = false;
      play(item.src);
    }
  }

  function answer(choice: string) {
    if (!current) return;
    const { word, item, key } = current;
    const ok = choice === item.answer;
    total++;
    if (ok) correct++;
    scoreLabel.textContent = `${correct} / ${total}（全 ${ROUND_SIZE} 問）`;
    answers.querySelectorAll('button').forEach((b) => (b.disabled = true));
    wordLabel.textContent = word.fr;
    resultLabel.className = `result ${ok ? 'ok' : 'ng'}`;
    resultLabel.textContent = `${ok ? '正解！' : '残念…'} ${word.fr} [${word.ipa}]＝${word.ja}`;
    // 答えた後は、どの形式でも発音を流す（綴り・音・意味をまとめて結びつけるため）
    play(word.src);
    if (total >= ROUND_SIZE) {
      resultLabel.textContent += `　── ${ROUND_SIZE} 問終わり：${correct} / ${ROUND_SIZE}`;
      nextButton.textContent = `▶ もう一度 ${ROUND_SIZE} 問`;
    }
    saveResult({ type: 'vocab', key, word: word.fr, chosen: choice, answer: item.answer, ok, item });
    if (!ok) {
      mistakes.add({
        key,
        word: document.createTextNode(word.fr),
        detail: `[${word.ipa}] ${word.ja}`,
        chosen: choice,
        correct: item.answer,
        src: word.src,
      });
    }
    current = null;
  }

  modeSelect.addEventListener('change', reset);
  groupSelect.addEventListener('change', reset);
  nextButton.addEventListener('click', ask);
  replayButton.addEventListener('click', () => current && play(current.item.src));
</script>

<style>
  .settings {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .settings label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
  }
  select {
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font: inherit;
    color: inherit;
  }
  .quiz-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .score {
    margin-left: auto;
    font-weight: 600;
  }
  .quiz-word {
    text-align: center;
    font-size: 2.2rem;
    font-weight: 700;
    margin: 4px 0 16px;
  }
  .answers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .answers :global(.answer) {
    padding: 12px 8px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    font: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    color: inherit;
  }
  .answers :global(.answer:not(:disabled):hover) {
    border-color: var(--accent);
  }
  .answers :global(.answer:disabled) {
    opacity: 0.5;
    cursor: default;
  }
  .result {
    min-height: 1.6em;
    margin: 12px 0 0;
    font-weight: 600;
  }
</style>
