---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { audioUrl } from '../../lib/audio';
import '../../styles/material.css';

export async function getStaticPaths() {
  const entries = await getCollection('vocab');
  return entries.map((entry) => ({ params: { unit: entry.data.unit }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'vocab'> };
const { unit, title, groups } = entry.data;
const total = groups.reduce((n, g) => n + g.words.length, 0);
---

<Base title={`${unit} 単語`}>
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>{unit} {title}：単語</h1>
      <p class="lead">
        全 {total} 語。カードをクリックすると発音を再生します。名詞は un / une を付けて読むので、性（男性・女性）も音で一緒に覚えられます。
        カードの下は例文で、クリックすると例文を再生します。
      </p>
    </header>

    <!-- 暗記の練習用。隠した側は、カードをクリックするとそのカードだけ表示される -->
    <!-- 下のグループを練習しているときに、ボタンを押すため上まで戻らなくて済むよう、画面の上に固定する。
         グループへのリンクも置き、長いページでも目的のグループへすぐ移れるようにする -->
    <div class="toolbar sticky">
      <div class="hide-buttons">
        <button type="button" class="pill" data-hide="ja" aria-pressed="false">意味を隠す</button>
        <button type="button" class="pill" data-hide="fr" aria-pressed="false">フランス語を隠す</button>
        <a class="pill primary quiz-link" href={`/vocab/${unit}/quiz`}>クイズで確かめる →</a>
      </div>
      <nav class="jump" aria-label="グループ">
        {groups.map((g, i) => <a href={`#g-${i}`}>{g.name}</a>)}
      </nav>
    </div>

    {
      groups.map((g, i) => (
        <section class="card group" id={`g-${i}`}>
          <div class="section-head">
            <h2>
              {g.name} <small class="count">{g.words.length} 語</small>
            </h2>
            <button type="button" class="pill play-group">▶ まとめて再生</button>
          </div>
          <ul class="words">
            {g.words.map((w) => (
              <li>
                <button type="button" class="tile play word" data-src={audioUrl(w.tts ?? w.fr)}>
                  <span class="line">
                    <span class="fr">{w.fr}</span>
                    {w.f && <span class="fem">/ {w.f}</span>}
                    {w.g && <span class={`gender ${w.g}`}>{w.g === 'm' ? '男' : '女'}</span>}
                  </span>
                  <span class="ipa">
                    [{w.ipa}]{w.f_ipa && ` / [${w.f_ipa}]`}
                  </span>
                  <span class="ja">
                    {w.ja} <small class="pos">{w.pos}</small>
                  </span>
                  {w.pl && <span class="pl">複数形：{w.pl}</span>}
                  {w.note && <span class="note">{w.note}</span>}
                </button>
                {w.ex && (
                  <button type="button" class="play ex" data-src={audioUrl(w.ex.fr)}>
                    <span class="ex-fr">▶ {w.ex.fr}</span>
                    <span class="ex-ja">{w.ex.ja}</span>
                  </button>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>

<script>
  import { bindPlayButtons, playAll } from '../../scripts/player';

  bindPlayButtons();

  document.querySelectorAll<HTMLButtonElement>('.play-group').forEach((button) =>
    button.addEventListener('click', () => {
      const tiles = [...button.closest('.group')!.querySelectorAll<HTMLElement>('.word')];
      playAll(tiles.map((el) => ({ src: el.dataset.src!, el })));
    }),
  );

  const main = document.querySelector('main')!;
  document.querySelectorAll<HTMLButtonElement>('[data-hide]').forEach((button) =>
    button.addEventListener('click', () => {
      const on = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(on));
      main.classList.toggle(`hide-${button.dataset.hide}`, on);
      // 隠し方を変えたら、クリックで表示したカードもまた隠す
      document.querySelectorAll('.word.revealed').forEach((el) => el.classList.remove('revealed'));
    }),
  );
  document.querySelectorAll('.word').forEach((el) => el.addEventListener('click', () => el.classList.add('revealed')));
</script>

<style>
  .sticky {
    position: sticky;
    top: 0;
    z-index: 1;
    flex-direction: column;
    gap: 6px;
    padding: 8px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .hide-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .quiz-link {
    margin-left: auto;
    text-decoration: none;
  }
  .jump {
    display: flex;
    gap: 4px 12px;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  .jump a {
    text-decoration: none;
  }
  /* リンクで移ったとき、グループの見出しが固定したツールバーに隠れないようにする */
  .group {
    scroll-margin-top: 110px;
  }
  .count {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .words {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
  }
  .words li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .word {
    width: 100%;
    flex: 1;
  }
  /* 例文は単語カードの外に置く（ボタンの中にボタンは置けないため） */
  .ex {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    padding: 6px 10px;
    border: 1px dashed var(--border);
    border-radius: 8px;
    background: none;
    text-align: left;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .ex.playing {
    border-color: var(--accent);
  }
  .ex-ja {
    color: var(--muted);
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }
  .fr {
    font-size: 1.15rem;
  }
  .fem {
    font-weight: 600;
  }
  .gender {
    font-size: 0.7rem;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .gender.f {
    background: var(--caution-soft);
    color: var(--caution);
  }
  .ja {
    font-size: 0.9rem;
  }
  .pos,
  .pl {
    font-size: 0.75rem;
    color: var(--muted);
  }
  /* 隠すのは見た目だけ（visibility）。カードの大きさが変わらないので、並びが崩れない */
  main.hide-ja .word:not(.revealed) :is(.ja, .pl, .note),
  main.hide-fr .word:not(.revealed) :is(.line, .ipa, .pl) {
    visibility: hidden;
  }
  /* 例文には単語も意味も入っているので、どちらかを隠しているあいだは、カードを開くまで例文も隠す */
  main:is(.hide-ja, .hide-fr) li:has(.word:not(.revealed)) .ex {
    visibility: hidden;
  }
</style>
