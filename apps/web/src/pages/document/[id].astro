---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Questions from '../../components/Questions.astro';
import { audioUrl } from '../../lib/audio';
import { documentId } from '../../lib/materials';
import '../../styles/material.css';

export async function getStaticPaths() {
  const entries = await getCollection('documents');
  return entries.map((entry) => ({ params: { id: documentId(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'documents'> };
const { unit, title, type, situation, header, lines, questions } = entry.data;

const typeNames: Record<string, string> = {
  email: 'メール',
  message: 'メッセージ',
  notice: '掲示・お知らせ',
  ad: '広告',
  program: '予定表・時刻表',
  menu: 'メニュー・値段表',
};
---

<Base title={`${unit} 文書：${title}`}>
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>{title}</h1>
      <p class="lead">
        <span class="type">{typeNames[type] ?? type}</span>
        {situation}
      </p>
    </header>

    <section class="card">
      <h2>1. 読む</h2>
      <p class="sub">DELF の「読む」と同じく、知らない単語があっても、質問に必要な情報だけを探します。</p>
      <!-- 本番は紙の文書なので、ここでは訳も音声も出さずに読む -->
      <article class="doc">
        {header.length > 0 && (
          <div class="doc-header">
            {header.map((h) => <p>{h}</p>)}
          </div>
        )}
        {lines.map((l) => <p>{l.fr}</p>)}
      </article>
    </section>

    <section class="card">
      <h2>2. 質問に答える</h2>
      <Questions questions={questions} />
    </section>

    <section class="card">
      <details>
        <summary>3. 訳と音声で確かめる（行をクリックで、その行だけ再生）</summary>
        <button type="button" class="pill" id="play-all">▶ 通して再生</button>
        <ol class="script">
          {
            lines.map((l) => (
              <li>
                <button type="button" class="tile play line" data-src={audioUrl(l.tts ?? l.fr, l.voice)}>
                  <span class="fr">{l.fr}</span>
                  <span class="ja">{l.ja}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </details>
    </section>
  </main>
</Base>

<script>
  import { bindPlayButtons, playAll } from '../../scripts/player';

  bindPlayButtons();

  const lines = [...document.querySelectorAll<HTMLElement>('.line')];
  document.querySelector('#play-all')!.addEventListener('click', () =>
    playAll(lines.map((el) => ({ src: el.dataset.src!, el })), 400),
  );
</script>

<style>
  .type {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0 8px;
    margin-right: 6px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .doc {
    margin-top: 12px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .doc p {
    margin: 0 0 4px;
  }
  .doc-header {
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  #play-all {
    margin-top: 12px;
  }
  .script {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 6px;
  }
  .line {
    width: 100%;
  }
  .ja {
    font-size: 0.88rem;
  }
</style>
