---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Questions from '../../components/Questions.astro';
import { audioUrl } from '../../lib/audio';
import { listeningId } from '../../lib/materials';
import '../../styles/material.css';

export async function getStaticPaths() {
  const entries = await getCollection('listening');
  return entries.map((entry) => ({ params: { id: listeningId(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'listening'> };
const { unit, title, type, situation, speakers, lines, questions } = entry.data;

const typeNames: Record<string, string> = {
  dialogue: '会話',
  voicemail: '留守番電話',
  announcement: 'アナウンス',
  monologue: '1 人の話',
};
---

<Base title={`${unit} 聞き取り：${title}`}>
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>{title}</h1>
      <p class="lead">
        <span class="type">{typeNames[type] ?? type}</span>
        {situation}
      </p>
    </header>

    <section class="card">
      <div class="section-head">
        <h2>1. 聞く</h2>
        <button type="button" class="pill primary" id="play-all">▶ 通して再生</button>
      </div>
      <p class="sub">DELF の本番と同じく、最初はスクリプトを見ずに聞きます。何度聞いても構いません。</p>
    </section>

    <section class="card">
      <h2>2. 質問に答える</h2>
      <Questions questions={questions} />
    </section>

    <section class="card">
      <details>
        <summary>3. スクリプトで確かめる（行をクリックで、その行だけ再生）</summary>
        <p class="sub">キーボード：j / k か ↓ / ↑ で行を移動、スペースで再生。</p>
        <ol class="script">
          {
            lines.map((l) => (
              <li>
                <button type="button" class="tile play line" data-src={audioUrl(l.fr, l.voice)}>
                  <span class="speaker">{speakers[l.speaker]?.name ?? l.speaker}</span>
                  <span class="fr">{l.fr}</span>
                  <span class="ja">{l.ja}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </details>
    </section>
  </main>
</Base>

<script>
  import { bindPlayButtons, playAll } from '../../scripts/player';

  bindPlayButtons();

  const lines = [...document.querySelectorAll<HTMLElement>('.line')];
  document.querySelector('#play-all')!.addEventListener('click', () =>
    // スクリプトを開いていなくても、行の要素から音声を取り出して続けて再生する
    playAll(lines.map((el) => ({ src: el.dataset.src!, el })), 400),
  );

  // スクリプトをキーボードだけで聞き直せるようにする（ユーザーの希望。2026-10-19。1 文リーディングと同じ操作）。
  // スクリプトを開いているときだけ動かす。閉じているときは質問に答える段階で、スペースなどの既定の動作を邪魔しないため
  const script = document.querySelector('.script')!.closest('details')!;
  let current = 0;
  function select(i: number) {
    current = Math.max(0, Math.min(lines.length - 1, i));
    lines.forEach((l, j) => l.classList.toggle('current', j === current));
    lines[current].scrollIntoView({ block: 'nearest' });
  }
  // クリックした行も選ぶ。マウスで再生した後にキーボードで続けられるように
  lines.forEach((l, i) => l.addEventListener('click', () => select(i)));
  script.addEventListener('toggle', () => script.open && select(current));

  document.addEventListener('keydown', (e) => {
    if (!script.open) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.target instanceof HTMLSelectElement || e.target instanceof HTMLInputElement) return;
    if (e.key === 'j' || e.key === 'ArrowDown') select(current + 1);
    else if (e.key === 'k' || e.key === 'ArrowUp') select(current - 1);
    else if (e.key === ' ') lines[current].click();
    else return;
    // 既定の動作（ページのスクロール、フォーカス中の summary の開閉）と二重に動かないよう止める
    e.preventDefault();
  });
</script>

<style>
  .type {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0 8px;
    margin-right: 6px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .script {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 6px;
  }
  .line {
    width: 100%;
  }
  .line.current {
    outline: 2px solid var(--accent);
  }
  .speaker {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .ja {
    font-size: 0.88rem;
  }
</style>
