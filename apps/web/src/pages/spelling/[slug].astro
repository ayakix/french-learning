---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MistakeList from '../../components/MistakeList.astro';
import { audioUrl } from '../../lib/audio';
import '../../styles/material.css';

export async function getStaticPaths() {
  const entries = await getCollection('spellings');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'spellings'> };
const { title, lead, items } = entry.data;
const quizItems = items.map((i) => ({ ...i, src: audioUrl(i.fr) }));
---

<Base title={title}>
  <main>
    <header>
      <a href="/" class="back">← ホーム</a>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </header>

    <section class="card" id="quiz" data-slug={entry.id} data-items={JSON.stringify(quizItems)}>
      <div class="quiz-controls">
        <button type="button" id="quiz-next" class="pill primary">▶ 出題する</button>
        <button type="button" id="quiz-replay" class="pill" disabled>もう一度聞く</button>
        <span id="quiz-score" class="score">0 / 0（全 20 問）</span>
      </div>
      <div id="answers" class="answers"></div>
      <p id="quiz-result" class="result" aria-live="polite"></p>
      <MistakeList />
    </section>
  </main>
</Base>

<script>
  import { createMistakeList } from '../../scripts/mistakes';
  import { play } from '../../scripts/player';
  import { saveResult, spellingKey } from '../../scripts/results';
  import { ROUND_SIZE, createDeck } from '../../scripts/round';

  type Item = { fr: string; ipa: string; ja: string; wrong: string[]; src: string };

  const quiz = document.querySelector<HTMLElement>('#quiz')!;
  const items: Item[] = JSON.parse(quiz.dataset.items!);
  const slug = quiz.dataset.slug!;
  const nextButton = document.querySelector<HTMLButtonElement>('#quiz-next')!;
  const replayButton = document.querySelector<HTMLButtonElement>('#quiz-replay')!;
  const answers = document.querySelector<HTMLElement>('#answers')!;
  const scoreLabel = document.querySelector<HTMLElement>('#quiz-score')!;
  const resultLabel = document.querySelector<HTMLElement>('#quiz-result')!;

  const mistakes = createMistakeList((src, button) => play(src, button));

  let current: Item | null = null;
  let correct = 0;
  let total = 0;
  const nextItem = createDeck(items);

  function ask() {
    // 20 問終わった後に押されたら、点数を 0 に戻して次の 20 問を始める（間違えた問題の一覧は残す）
    if (total >= ROUND_SIZE) {
      correct = 0;
      total = 0;
      scoreLabel.textContent = `0 / 0（全 ${ROUND_SIZE} 問）`;
    }
    current = nextItem();
    const item = current;
    resultLabel.textContent = '';
    resultLabel.className = 'result';
    replayButton.disabled = false;
    nextButton.textContent = '▶ 次の問題';
    // 正解の位置で答えがわからないよう、選択肢の順番は毎回混ぜる
    const choices = [item.fr, ...item.wrong].sort(() => Math.random() - 0.5);
    answers.replaceChildren(
      ...choices.map((c) => {
        const b = Object.assign(document.createElement('button'), { type: 'button', className: 'answer', textContent: c });
        b.addEventListener('click', () => answer(c));
        return b;
      }),
    );
    play(item.src);
  }

  function answer(choice: string) {
    if (!current) return;
    const item = current;
    const ok = choice === item.fr;
    total++;
    if (ok) correct++;
    scoreLabel.textContent = `${correct} / ${total}（全 ${ROUND_SIZE} 問）`;
    answers.querySelectorAll('button').forEach((b) => (b.disabled = true));
    resultLabel.className = `result ${ok ? 'ok' : 'ng'}`;
    resultLabel.textContent = `${ok ? '正解！' : '残念…'} ${item.fr} [${item.ipa}]（${item.ja}）`;
    if (total >= ROUND_SIZE) {
      resultLabel.textContent += `　── ${ROUND_SIZE} 問終わり：${correct} / ${ROUND_SIZE}`;
      nextButton.textContent = `▶ もう一度 ${ROUND_SIZE} 問`;
    }
    saveResult({ type: 'spelling', key: spellingKey(slug, item.fr), word: item.fr, chosen: choice, answer: item.fr, ok });
    if (!ok) {
      mistakes.add({
        key: item.fr,
        word: document.createTextNode(item.fr),
        detail: `[${item.ipa}] ${item.ja}`,
        chosen: choice,
        correct: item.fr,
        src: item.src,
      });
    }
  }

  nextButton.addEventListener('click', ask);
  replayButton.addEventListener('click', () => current && play(current.src));
</script>

<style>
  .quiz-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .score {
    margin-left: auto;
    font-weight: 600;
  }
  .answers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    min-height: 3.2rem;
  }
  .answers :global(.answer) {
    padding: 14px 8px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    font: inherit;
    font-size: 1.3rem;
    font-weight: 700;
    color: inherit;
  }
  .answers :global(.answer:not(:disabled):hover) {
    border-color: var(--accent);
  }
  .answers :global(.answer:disabled) {
    opacity: 0.5;
    cursor: default;
  }
  .result {
    min-height: 1.6em;
    margin: 12px 0 0;
    font-weight: 600;
  }
</style>
