---
// 数字の聞き取りクイズ。音声を聞いて、数字（算用数字）で答える。
// 数字の画面（/numbers）の「聞いて当てる」は答えを見るだけで結果が残らなかったので、入力して自動で採点・記録できるようにした（2026-10-14、ユーザーの希望）。
// 綴り（quatorze など）ではなく数字で答えるのは、DELF A1 の聞き取りでも数字で書き取るためと、入力が楽で聞き取りに集中できるため
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MistakeList from '../../components/MistakeList.astro';
import { audioUrl } from '../../lib/audio';
import '../../styles/material.css';

const [entry] = await getCollection('numbers');
// 数字だけで答えられる項目に絞る（曜日・時刻・値段などは表記が数字だけではないため）
const groups = (entry?.data.groups ?? [])
  .map((g) => ({
    slug: g.slug,
    name: g.name,
    items: g.items
      .filter((i) => /^\d+$/.test(i.show))
      .map((i) => ({ slug: g.slug, group: g.name, show: i.show, fr: i.fr, ipa: i.ipa, src: audioUrl(i.tts ?? i.fr) })),
  }))
  .filter((g) => g.items.length > 0);
---

<Base title="数字の聞き取りクイズ">
  <main>
    <header>
      <a href="/numbers" class="back">← 数字・日付・時刻・値段</a>
      <h1>数字の聞き取りクイズ</h1>
      <p class="lead">
        音声を聞いて、数字で入力します（例：quatorze → 14）。Enter で答え合わせ（もう一度 Enter か Tab で次の問題）。20 問ずつ解きます。
        間違えた問題は復習画面（/review）にも出ます。
      </p>
    </header>

    <section class="card" id="quiz" data-groups={JSON.stringify(groups)}>
      <div class="settings">
        <label>
          範囲
          <!-- 先頭（0〜20）を初期値にする。まだ学んでいない範囲が出ないように、広い範囲は自分で選んだときだけ出す -->
          <select id="range">
            {groups.map((g) => <option value={g.slug}>{g.name}</option>)}
          </select>
        </label>
      </div>
      <div class="quiz-controls">
        <button type="button" id="quiz-next" class="pill primary">▶ 出題する</button>
        <button type="button" id="quiz-replay" class="pill" hidden>もう一度聞く</button>
        <span id="quiz-score" class="score">0 / 0（全 20 問）</span>
      </div>
      <p id="quiz-word" class="quiz-word" aria-live="polite">&nbsp;</p>
      <p id="quiz-sub" class="sub center">&nbsp;</p>
      <div class="row">
        <input id="quiz-input" type="text" inputmode="numeric" autocomplete="off" disabled />
        <button type="button" id="quiz-check" class="pill" disabled>答え合わせ</button>
      </div>
      <p id="quiz-result" class="result" aria-live="polite"></p>
      <MistakeList />
    </section>
  </main>
</Base>

<script>
  import { judge, verdictLabel } from '../../scripts/judge';
  import { createMistakeList } from '../../scripts/mistakes';
  import { play } from '../../scripts/player';
  import { numberKey, saveResult, type ReviewItem } from '../../scripts/results';
  import { ROUND_SIZE, createDeck } from '../../scripts/round';

  type NumberItem = { slug: string; group: string; show: string; fr: string; ipa: string; src: string };
  type Group = { slug: string; name: string; items: NumberItem[] };

  const quiz = document.querySelector<HTMLElement>('#quiz')!;
  const groups: Group[] = JSON.parse(quiz.dataset.groups!);
  const rangeSelect = document.querySelector<HTMLSelectElement>('#range')!;
  const nextButton = document.querySelector<HTMLButtonElement>('#quiz-next')!;
  const replayButton = document.querySelector<HTMLButtonElement>('#quiz-replay')!;
  const scoreLabel = document.querySelector<HTMLElement>('#quiz-score')!;
  const wordLabel = document.querySelector<HTMLElement>('#quiz-word')!;
  const subLabel = document.querySelector<HTMLElement>('#quiz-sub')!;
  const input = document.querySelector<HTMLInputElement>('#quiz-input')!;
  const checkButton = document.querySelector<HTMLButtonElement>('#quiz-check')!;
  const resultLabel = document.querySelector<HTMLElement>('#quiz-result')!;

  const mistakes = createMistakeList((src, button) => play(src, button));

  let current: { num: NumberItem; item: ReviewItem; key: string } | null = null;
  let correct = 0;
  let total = 0;

  function selected() {
    return groups.find((g) => g.slug === rangeSelect.value)?.items ?? [];
  }
  let nextNumber = createDeck(selected());

  // 範囲を変えたら、点数と出題の順番をやり直す
  function reset() {
    nextNumber = createDeck(selected());
    correct = 0;
    total = 0;
    current = null;
    scoreLabel.textContent = `0 / 0（全 ${ROUND_SIZE} 問）`;
    wordLabel.innerHTML = '&nbsp;';
    subLabel.innerHTML = '&nbsp;';
    input.value = '';
    input.disabled = true;
    checkButton.disabled = true;
    resultLabel.textContent = '';
    replayButton.hidden = true;
    nextButton.textContent = '▶ 出題する';
  }

  function makeItem(num: NumberItem): ReviewItem {
    return {
      title: '数字の聞き取り（聞いて数字で書く）',
      href: '/numbers/quiz',
      fr: num.fr,
      ipa: num.ipa,
      ja: num.group,
      src: num.src,
      // 問題文はなし（音声だけで出題する）
      answer: num.show,
      choices: [],
    };
  }

  function ask() {
    if (total >= ROUND_SIZE) {
      correct = 0;
      total = 0;
      scoreLabel.textContent = `0 / 0（全 ${ROUND_SIZE} 問）`;
    }
    const num = nextNumber();
    current = { num, item: makeItem(num), key: numberKey(num.slug, num.show) };
    resultLabel.textContent = '';
    resultLabel.className = 'result';
    nextButton.textContent = '▶ 次の問題';
    input.value = '';
    input.disabled = false;
    checkButton.disabled = false;
    input.focus();
    wordLabel.textContent = '🔊';
    subLabel.innerHTML = '&nbsp;';
    replayButton.hidden = false;
    play(num.src);
  }

  function check() {
    if (!current || input.disabled || input.value.trim() === '') return;
    const { num, item, key } = current;
    // 全角数字で打っても正解になる（judge が半角にそろえる）
    const chosen = input.value.trim();
    const ok = judge(chosen, num.show) === 'ok';
    total++;
    if (ok) correct++;
    scoreLabel.textContent = `${correct} / ${total}（全 ${ROUND_SIZE} 問）`;
    input.disabled = true;
    checkButton.disabled = true;
    wordLabel.textContent = num.show;
    subLabel.textContent = `${num.fr} [${num.ipa}]`;
    resultLabel.className = `result ${ok ? 'ok' : 'ng'}`;
    resultLabel.textContent = `${ok ? verdictLabel.ok : verdictLabel.ng}　${num.show}：${num.fr}${ok ? '' : `（あなた：${chosen}）`}`;
    // 答えた後にもう一度流す（数字と音を結びつけるため）
    play(num.src);
    if (total >= ROUND_SIZE) {
      resultLabel.textContent += `　── ${ROUND_SIZE} 問終わり：${correct} / ${ROUND_SIZE}`;
      nextButton.textContent = `▶ もう一度 ${ROUND_SIZE} 問`;
    }
    saveResult({ type: 'number', key, word: num.fr, chosen, answer: num.show, ok, item });
    if (!ok) {
      mistakes.add({
        key,
        word: document.createTextNode(num.show),
        detail: `${num.fr} [${num.ipa}]`,
        chosen,
        correct: num.show,
        src: num.src,
      });
    }
    current = null;
    // Enter で次の問題へ進めるよう、出題ボタンにフォーカスを移す。
    // ただし 20 問終わったときは移さない。やめ時がわかるように（動詞の活用クイズと同じ）
    if (total < ROUND_SIZE) nextButton.focus();
  }

  input.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.isComposing) return;
    // 既定の動作を止める。止めないと、check() でフォーカスを移した出題ボタンが同じ Enter で押され、答えを見る前に次の問題へ進んでしまう
    e.preventDefault();
    check();
  });
  // 答えた後は Tab でも次の問題へ進める（動詞の活用クイズと同じ）
  nextButton.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || e.shiftKey) return;
    e.preventDefault();
    nextButton.click();
  });
  checkButton.addEventListener('click', check);
  rangeSelect.addEventListener('change', reset);
  nextButton.addEventListener('click', ask);
  replayButton.addEventListener('click', () => current && play(current.item.src));
</script>

<style>
  .settings {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .settings label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
  }
  select {
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font: inherit;
    color: inherit;
  }
  .quiz-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .score {
    margin-left: auto;
    font-weight: 600;
  }
  .quiz-word {
    text-align: center;
    font-size: 2.2rem;
    font-weight: 700;
    margin: 4px 0 4px;
  }
  .center {
    text-align: center;
    margin: 0 0 16px;
  }
  .row {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 2px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    font: inherit;
    font-size: 1.2rem;
    color: inherit;
  }
  input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .result {
    min-height: 1.6em;
    margin: 12px 0 0;
    font-weight: 600;
  }
</style>
