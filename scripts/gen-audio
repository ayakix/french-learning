#!/bin/bash
# 教材の YAML に書かれたテキストを、まとめて音声化する（.cache/tts/ に保存）。
# 使い方: scripts/gen-audio materials/a1/00-pronunciation/00-1-alphabet.yaml [...]
#
# 音声は git 管理外のため、clone 直後や教材を追加したときに実行する。
# say-fr のキャッシュを経由するので、生成済みのテキストはクレジットを消費しない。
# 各項目の tts（なければ fr）を音声化する。表示用の綴りと読ませたいテキストが違う場合に tts を使う。
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

if [ $# -lt 1 ]; then
  echo "使い方: scripts/gen-audio <教材の YAML> [...]" >&2
  exit 1
fi

for yaml in "$@"; do
  yq -r '.[] | (.tts // .fr) | select(. != null)' "$yaml" | while IFS= read -r text; do
    "$root/scripts/say-fr" --no-play "$text" > /dev/null
    echo "ok: $text"
  done
done
