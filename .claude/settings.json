{
  "promptSuggestionEnabled": false,
  "sandbox": {
    "excludedCommands": ["say *", "afplay *", "scripts/say-fr *", "scripts/quiz *"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
